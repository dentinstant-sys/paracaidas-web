# Condor Sky — Cloud Functions · variables de entorno
#
# Este archivo es solo una PLANTILLA. El .env real NO se comitea.
# Las credenciales reales de Bold van en el gestor de secretos del negocio:
#   <ruta-de-llaves>
#
# Para el emulador local: copiar a .env y llenar los valores.
# Para producción: usar secretos de Firebase, p.ej.
#   firebase functions:secrets:set BOLD_SECRET_KEY

# Base de la API de Bold — [VERIFICAR contra la documentación oficial de Bold]
BOLD_API_BASE=https://integrations.api.bold.co

# Llave de identidad / pública de Bold
BOLD_IDENTITY_KEY=

# Llave secreta de Bold (firma de integridad). Si está vacía → modo simulado.
BOLD_SECRET_KEY=

# Secreto para verificar la autenticidad de los webhooks de Bold
BOLD_WEBHOOK_SECRET=
